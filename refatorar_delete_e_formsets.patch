@@ -0,0 +1,6 @@
+{% comment %}
+Cabeçalho (vermelho) das páginas de exclusão.
+   Uso: {% include "partials/_delete_header.html" with title="Excluir Paciente" %}
+   Opcional: subtitle (padrão: "Esta ação não pode ser desfeita.")
+{% endcomment %}
+{% include "partials/_card_header.html" with variant="danger" icon="bi-trash3-fill" title=title subtitle=subtitle|default:"Esta ação não pode ser desfeita." %}
diff --git a/backend/src/templates/partials/_inline_formset.html b/backend/src/templates/partials/_inline_formset.html
new file mode 100644
index 0000000..c55ae7e
--- /dev/null
+++ b/backend/src/templates/partials/_inline_formset.html
@@ -0,0 +1,59 @@
+{% comment %}
+Seção de inline formset dinâmico (adicionar/remover linhas sem recarregar a página).
+   Uso: {% include "partials/_inline_formset.html" with formset=telefone_formset row_template="partials/_telefone_row.html" item="telefone" icon="bi-telephone" title="Telefones" add_label="Adicionar telefone" %}
+   A linha (row_template) recebe `f` e precisa ter: a classe "<item>-row", um botão
+   com a classe "remove-<item>" e o campo {{ f.DELETE }} dentro de um elemento .d-none.
+{% endcomment %}
+<div class="app-form-section">
+
+    <div class="app-form-section-title">
+        <i class="bi {{ icon }}"></i>
+        {{ title }}
+    </div>
+
+    {{ formset.management_form }}
+
+    {% if formset.non_form_errors %}
+        <div class="alert alert-danger">{{ formset.non_form_errors }}</div>
+    {% endif %}
+
+    <div id="{{ item }}-list">
+        {% for f in formset %}
+            {% include row_template with f=f %}
+        {% endfor %}
+    </div>
+
+    {# Molde para novas linhas; __prefix__ é trocado pelo índice no JS. #}
+    <template id="{{ item }}-empty">
+        {% include row_template with f=formset.empty_form %}
+    </template>
+
+    <button type="button" id="add-{{ item }}" class="btn btn-outline-primary btn-sm">
+        <i class="bi bi-plus-lg me-1"></i>
+        {{ add_label }}
+    </button>
+
+</div>
+
+<script>
+    (function () {
+        var list = document.getElementById('{{ item }}-list');
+        var total = document.getElementById('id_{{ formset.prefix }}-TOTAL_FORMS');
+        var template = document.getElementById('{{ item }}-empty').innerHTML;
+
+        document.getElementById('add-{{ item }}').addEventListener('click', function () {
+            var index = parseInt(total.value, 10);
+            list.insertAdjacentHTML('beforeend', template.replaceAll('__prefix__', index));
+            total.value = index + 1;
+        });
+
+        list.addEventListener('click', function (event) {
+            var button = event.target.closest('.remove-{{ item }}');
+            if (!button) return;
+            var row = button.closest('.{{ item }}-row');
+            // O Django ignora (e apaga, se já existir) formulários com DELETE marcado.
+            row.querySelector('input[name$="-DELETE"]').checked = true;
+            row.classList.add('d-none');
+        });
+    })();
+</script>
