+++ b/backend/src/templates/partials/_delete_actions.html
@@ -0,0 +1,5 @@
+{% comment %}
+Rodapé das páginas de exclusão: Cancelar + botão vermelho.
+   Uso: {% url 'app:x_list' as cancel_url %}{% include "partials/_delete_actions.html" with cancel_url=cancel_url submit_label="Sim, excluir X" %}
+{% endcomment %}
+{% include "partials/_form_actions.html" with cancel_url=cancel_url submit_label=submit_label submit_icon="bi-trash3" submit_class="btn-danger" %}
diff --git a/backend/src/templates/partials/_delete_cascade.html b/backend/src/templates/partials/_delete_cascade.html
new file mode 100644
index 0000000..15b05ad
--- /dev/null
+++ b/backend/src/templates/partials/_delete_cascade.html
@@ -0,0 +1,20 @@
+{% comment %}
+Aviso "Ao excluir, também serão apagados: ..." (só aparece se algum contador for > 0).
+   Uso: {% include "partials/_delete_cascade.html" with consultas=object.consultas.count telefones=object.telefones.count %}
+   Contadores aceitos (passe só os que se aplicam): consultas, prontuarios, faturamentos,
+   disponibilidades, espera, telefones, enderecos.
+{% endcomment %}
+{% if consultas or prontuarios or faturamentos or disponibilidades or espera or telefones or enderecos %}
+    <div class="app-alert-danger">
+        <strong><i class="bi bi-exclamation-triangle-fill me-1"></i> Ao excluir, também serão apagados:</strong>
+        <ul>
+            {% if consultas %}<li>{{ consultas }} consulta{{ consultas|pluralize }}</li>{% endif %}
+            {% if prontuarios %}<li>{{ prontuarios }} prontuário{{ prontuarios|pluralize }}</li>{% endif %}
+            {% if faturamentos %}<li>{{ faturamentos }} faturamento{{ faturamentos|pluralize }}</li>{% endif %}
+            {% if disponibilidades %}<li>{{ disponibilidades }} disponibilidade{{ disponibilidades|pluralize }}</li>{% endif %}
+            {% if espera %}<li>{{ espera }} registro{{ espera|pluralize }} na lista de espera</li>{% endif %}
+            {% if telefones %}<li>{{ telefones }} telefone{{ telefones|pluralize }}</li>{% endif %}
+            {% if enderecos %}<li>{{ enderecos }} endereço{{ enderecos|pluralize }}</li>{% endif %}
+        </ul>
+    </div>
+{% endif %}
diff --git a/backend/src/templates/partials/_delete_header.html b/backend/src/templates/partials/_delete_header.html
